rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Lesson 2 demo collection — unchanged
    match /documents/{docId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if signedIn() && request.auth.uid == resource.data.userId;
    }

    // Product catalog — any signed-in user can browse and manage products
    match /products/{productId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn();
    }

    // User profiles — only the owner can read/edit/delete their own doc
    match /users/{userId} {
      allow read, update, delete: if isOwner(userId);
      allow create: if isOwner(userId);
    }

    // Orders — users can only create/read their own orders, never edit/delete
    match /orders/{orderId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
